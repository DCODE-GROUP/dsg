{
    "name": "dcodegroup/dsg",
    "description": "UI components for livewire 3.",
    "type": "library",
    "require": {
        "spatie/laravel-package-tools": "^1.16",
        "blade-ui-kit/blade-heroicons": "^2.0",
        "php": "^8.0|^8.1|^8.2|^8.3|^8.4|^8.5",
        "laravel/framework": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.12"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.42|^2.52",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-log-dumper": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Dcodegroup\\Dsg\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Nathan Rzepecki",
            "email": "nathan@lionslair.net.au",
            "homepage": "https://nathanrzepecki.me"
        },
        {
            "name": "Dcode Group",
            "email": "forge@dcodegroup.com",
            "homepage": "https://dcodegroup.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    }
}
